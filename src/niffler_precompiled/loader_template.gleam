//// Generation of the Erlang loader module.
////
//// The module name must be exactly the name passed to `rustler::init!`, and
//// every NIF function/arity must be exported with a stub or ERTS refuses to
//// load the library (`bad_lib` / "Function not found").

import gleam/int
import gleam/list
import gleam/string
import niffler_precompiled/config

pub fn render(
  package: String,
  nif_module: String,
  functions: List(config.Function),
) -> String {
  let exports = case functions {
    [] -> ""
    _ -> "-export([" <> render_exports(functions) <> "]).\n"
  }

  let stubs = functions |> list.map(render_stub) |> string.join("\n")

  "%% Generated by niffler_precompiled. Do not edit.\n"
  <> "%% Regenerate with: niffler generate\n"
  <> "-module("
  <> nif_module
  <> ").\n"
  <> "-on_load(init/0).\n"
  <> exports
  <> "\n"
  <> "init() ->\n"
  <> "    code:purge(?MODULE),\n"
  <> "    case niffler_precompiled:artifact_path(<<\""
  <> package
  <> "\">>) of\n"
  <> "        {ok, Path} ->\n"
  <> "            erlang:load_nif(binary_to_list(Path), []);\n"
  <> "        {error, Reason} ->\n"
  <> "            niffler_precompiled:raise_load_error(<<\""
  <> package
  <> "\">>, Reason)\n"
  <> "    end.\n"
  <> "\n"
  <> stubs
}

fn render_exports(functions: List(config.Function)) -> String {
  functions
  |> list.map(fn(function) {
    function.name <> "/" <> int.to_string(function.arity)
  })
  |> string.join(", ")
}

fn render_stub(function: config.Function) -> String {
  function.name
  <> "("
  <> argument_list(function.arity)
  <> ") ->\n"
  <> "    erlang:nif_error(nif_not_loaded).\n"
}

fn argument_list(arity: Int) -> String {
  argument_list_loop(arity, 0, [])
}

fn argument_list_loop(
  arity: Int,
  index: Int,
  accumulator: List(String),
) -> String {
  case index >= arity {
    True -> string.join(list.reverse(accumulator), ", ")
    False ->
      argument_list_loop(arity, index + 1, [
        "_Arg" <> int.to_string(index),
        ..accumulator
      ])
  }
}

/// A stable representation of the generated file, useful for `generate --check`.
pub fn checksum_input(
  package: String,
  nif_module: String,
  functions: List(config.Function),
) -> String {
  render(package, nif_module, functions)
}
